# ─────────────────────────────────────────────────────────────────────────────
# NEXORA — Configuración de entorno
# Copia este archivo como .env y completa los valores. Nunca subas .env al repo.
# ─────────────────────────────────────────────────────────────────────────────

# Aplicación
APP_NAME=NEXORA
APP_ENV=development
APP_VERSION=0.1.0
PORT=8000
LOG_LEVEL=INFO

# URL del cliente. En local Vite corre en 5173; en producción usa tu dominio.
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma. En producción: https://tu-dominio.com
CORS_ORIGINS=http://localhost:5173

# ── Supabase Postgres ────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Usa el pooler (puerto 6543) para despliegues serverless y añade ?sslmode=require.
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://TU_REF.supabase.co
# Clave service_role SOLO en el servidor. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_STORAGE_BUCKET=nexora-documents
# local: guarda en ./uploads | supabase: usa Supabase Storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# ── Seguridad / sesión ───────────────────────────────────────────────────────
# Genera secretos largos, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-este-secreto-jwt-por-uno-largo-y-aleatorio
SESSION_SECRET=cambia-este-secreto-de-sesion-por-uno-largo-y-aleatorio
JWT_EXPIRES_MINUTES=10080
COOKIE_NAME=nexora_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI local:
#   http://localhost:8000/api/auth/google/callback
# Authorized redirect URI producción:
#   https://TU_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Super administración ─────────────────────────────────────────────────────
# Emails separados por coma que reciben el rol global super_admin al iniciar sesión.
SUPER_ADMIN_EMAILS=

# ── Motor LLM ────────────────────────────────────────────────────────────────
# openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-tu-openai-api-key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_PAGES=8
LLM_MAX_INPUT_CHARS=60000
LLM_TIMEOUT_SECONDS=120

# ── Reglas de auditoría ──────────────────────────────────────────────────────
DEFAULT_PRICE_SPIKE_THRESHOLD_PCT=10
MIN_EXTRACTION_CONFIDENCE=0.75
DEFAULT_CURRENCY=CLP
PRICE_LOOKBACK_DAYS=365
MIN_HISTORY_SAMPLES=2
MAX_UPLOAD_MB=25

# ── Procesamiento ────────────────────────────────────────────────────────────
# true: procesa en BackgroundTasks al subir. El worker sigue disponible para reintentos.
PROCESS_IN_BACKGROUND=true
WORKER_POLL_SECONDS=10
